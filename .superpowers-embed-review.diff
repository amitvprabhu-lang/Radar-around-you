+      assert.ok(Math.abs(n.start - w.start) < 2 * 6e4 && Math.abs(n.end - w.end) < 2 * 6e4, `${id} ${day}: ${new Date(n.start).toISOString()} ${new Date(w.start).toISOString()}`);
