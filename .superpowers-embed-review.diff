+    for (var j = 0; j < track.length; j++) if (!ll(track[j]) || typeof track[j].hours !== "number") throw new Error("storms: a forecast point fails its checks");
+    var a = Math.max(wTime(s.issued) || 0, wTime(s.updated) || 0);
