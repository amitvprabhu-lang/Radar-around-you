+// the newest advisory time is reported too.
+export function stormModel(doc, now, C) {
+  var g = wTime(doc && doc.generated), out = [], adv = null;
+  var ll = function (p) { return p && p.lat >= -90 && p.lat <= 90 && p.lon >= -180 && p.lon <= 180; };
